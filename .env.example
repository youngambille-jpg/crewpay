# Copy to `.env` (gitignored) and fill in. `npm run api` and `npm run
# smoke:live` load it automatically via `node --env-file-if-exists=.env`.
# Never commit a real value: `.env` is the only place a secret belongs.

# Bearer token the API requires on every route except /health, /v1/live/health
# and the PingPay webhook. Generate one: `openssl rand -hex 32`. Required.
CREWPAY_API_TOKEN=

# The org that token may act on (default: org_1).
CREWPAY_ORG_ID=org_1

# PingPay publishable key. Wires real invoice checkout and Agent Pay; without it
# those routes answer 400. Find it in the PingPay dashboard.
PING_API_KEY=

# PingPay webhook signing secret. Set it to verify signed webhook deliveries;
# unset, the webhook route is disabled.
PING_WEBHOOK_SECRET=

# Optional service overrides (defaults are the live ones).
# PING_BASE_URL=https://pay.pingpay.io
# ONECLICK_BASE_URL=https://1click.chaindefuser.com
# OUTLAYER_BASE_URL=https://api.outlayer.ai
