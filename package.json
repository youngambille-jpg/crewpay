{
  "name": "crewpay",
  "private": true,
  "version": "0.0.0",
  "description": "Payroll and payouts for the agentic workforce.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test",
    "test:policy": "node --test packages/policy/src/engine.test.ts",
    "test:ledger": "node --test packages/ledger/src/journal.test.ts",
    "test:signer": "node --test packages/signer/src/*.test.ts",
    "api": "node --env-file-if-exists=.env apps/api/src/serve.ts",
    "verify:tokens": "node scripts/verify-tokens.ts",
    "smoke:live": "node --env-file-if-exists=.env scripts/smoke-live.ts",
    "e2e:testnet": "node scripts/e2e-testnet.ts",
    "e2e:testnet-payout": "node scripts/e2e-testnet-payout.ts",
    "typecheck": "tsc --noEmit",
    "web": "npm --workspace @crewpay/web run dev",
    "web:build": "npm --workspace @crewpay/web run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
